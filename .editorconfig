root = true

[*]
indent_style = space
indent_size = 2
tab_width = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{go,tmpl}]
indent_style = tab

[go.*]
indent_style = tab

[modules/apispec/*_json.tmpl]
indent_style = space
insert_final_newline = false

[Makefile]
indent_style = tab
